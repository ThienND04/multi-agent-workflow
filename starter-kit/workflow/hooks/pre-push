#!/usr/bin/env sh
# workflow-multi-agent: block-push
# Hook git do workflow multi-agent cài (sh workflow/hooks/install.sh).
# Chặn MỌI lần git push, với mọi công cụ AI (Claude Code, Codex, Gemini, Antigravity…),
# vì git tự chạy hook này trước khi push, bất kể ai gọi lệnh.
# Chủ dự án tự push bằng:  git push --no-verify <remote> <nhánh>
# (agent bị cấm dùng --no-verify và cấm sửa hook, xem AGENTS.md mục 6).

echo "git push bị chặn bởi workflow multi-agent." >&2
echo "- Nếu bạn là AI agent: KHÔNG thử cách khác. Ghi câu hỏi cho Master; chỉ chủ dự án quyết định và tự push." >&2
echo "- Nếu bạn là chủ dự án: git push --no-verify ${1:-origin} <nhánh>" >&2
exit 1
