diff --git a/server/src/routes/healthRoute.js b/server/src/routes/healthRoute.js
new file mode 100644
index 0000000..0b144fe
--- /dev/null
+++ b/server/src/routes/healthRoute.js
@@ -0,0 +1,11 @@
+const express = require('express');
+const httpStatus = require('http-status');
+
+const router = express.Router();
+
+// Liveness only: must not touch the DB so it stays green when Mongo is down.
+router.get('/', (req, res) => {
+    res.status(httpStatus.default.OK).json({ status: 'ok' });
+});
+
+module.exports = router;
diff --git a/server/src/routes/index.js b/server/src/routes/index.js
index f605296..2e91ad2 100644
--- a/server/src/routes/index.js
+++ b/server/src/routes/index.js
@@ -2,6 +2,7 @@ const express = require('express');
 const { api } = require('../config/cloudinary');
 const secretRoute = require('./secretRoute');
 const authRoute = require('./authRoute');
+const healthRoute = require('./healthRoute');
 const config = require('../config/config');
 
 const router = express.Router();
@@ -9,20 +10,24 @@ const router = express.Router();
 const defaultRoutes = [
     {
         path: '/auth',
-        route: authRoute,
+        route: authRoute
     },
     {
         path: '/secret',
-        route: secretRoute,
+        route: secretRoute
     },
-]
+    {
+        path: '/health',
+        route: healthRoute
+    }
+];
 
 const devRoutes = [
     {
         path: '/docs',
-        route: require('./docsRoute'),
+        route: require('./docsRoute')
     }
-]
+];
 
 defaultRoutes.forEach((route) => {
     router.use(route.path, route.route);
@@ -34,4 +39,4 @@ if (config.env === 'development') {
     });
 }
 
-module.exports = router;
\ No newline at end of file
+module.exports = router;
diff --git a/server/tests/health.test.js b/server/tests/health.test.js
new file mode 100644
index 0000000..dc089ef
--- /dev/null
+++ b/server/tests/health.test.js
@@ -0,0 +1,12 @@
+const request = require('supertest');
+const app = require('../src/app');
+
+describe('GET /api/health', () => {
+    it('returns 200 and {"status":"ok"} without authentication', async () => {
+        const response = await request(app).get('/api/health');
+
+        expect(response.status).toBe(200);
+        expect(response.headers['content-type']).toMatch(/application\/json/);
+        expect(response.body).toEqual({ status: 'ok' });
+    });
+});
